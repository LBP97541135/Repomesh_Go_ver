<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RepoMesh · 首批六项评审</title><style>
*{box-sizing:border-box}html,body{margin:0;background:#131313;color:#ddd;font:14px/1.65 'Segoe UI','Microsoft YaHei',sans-serif;color-scheme:dark}button,select{font:inherit;color:inherit}button{cursor:pointer;background:#252525;border:1px solid #414141;border-radius:7px;padding:8px 12px}button:hover{background:#323232}button:focus-visible,select:focus-visible{outline:2px solid #c8d1c4;outline-offset:2px}button:disabled{opacity:.5;cursor:default}a{color:#b7cbbd}h1{font-size:26px;font-weight:500;margin:8px 0}h2{font-size:17px;font-weight:500;margin:0 0 10px}p{color:#aaa;margin:6px 0 16px}.page{max-width:1020px;margin:auto;padding:28px}.eyebrow{color:#b8aa8d;font-size:12px}.intro{max-width:720px}.rows{border:1px solid #363636;border-radius:10px;margin-top:24px;overflow:hidden}.row{display:grid;grid-template-columns:38px 1fr auto;gap:15px;padding:20px;border-bottom:1px solid #333;align-items:start}.row:last-child{border-bottom:0}.num{color:#9fa89e;font-size:19px}.row p{font-size:12px;margin:4px 0 10px}.actions{display:flex;gap:7px;flex-wrap:wrap}.row small{display:block;color:#b5a780;font-size:11px;margin-top:7px}.primary{background:#d9dfd7;color:#171917;border-color:#d9dfd7}.footer{font-size:12px;color:#999;margin-top:24px}.panel{margin-top:20px;border:1px solid #363636;border-radius:9px;overflow:hidden}.panelhead{padding:17px 20px;border-bottom:1px solid #363636;display:flex;justify-content:space-between;gap:12px}.body{padding:24px}.notice{padding:16px;background:#27231c;border:1px solid #514735;border-radius:8px;color:#cbbb97;margin-bottom:20px}.notice p{color:inherit}.muted{color:#999}.demo{background:#201e19;border:1px solid #484133;padding:15px;border-radius:8px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:20px 0}.demo select{background:#292722;border:1px solid #514c40;border-radius:5px;padding:6px;max-width:220px}.demo strong{font-size:12px;font-weight:400;color:#cbb98c}.item{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid #343434;padding:14px 0}.skeleton{height:17px;background:#282828;border-radius:5px;margin:16px 0;width:75%}.skeleton:nth-child(2){width:50%}.compare{display:grid;grid-template-columns:1fr 1fr;gap:12px}.compare>div{border:1px solid #3c3c3c;border-radius:8px;padding:15px}.checks{padding:0;list-style:none}.checks li{padding:14px 0;border-bottom:1px solid #353535}.checks small{display:block;color:#999}.tag{font-size:11px;padding:2px 6px;border:1px solid #4c4b40;border-radius:5px;color:#b7b69f}.top{display:flex;justify-content:space-between;gap:12px}@media(max-width:620px){.page{padding:20px 16px}.row{grid-template-columns:25px 1fr;padding:17px 14px}.row>.tag{grid-column:2}.compare{grid-template-columns:1fr}.panelhead{flex-wrap:wrap}.item{flex-wrap:wrap}}
</style></head><body><div id="review-root"></div><script>(()=>{'use strict';
const root=document.getElementById('review-root');let screen='review',page='list',sample='normal',message='';
const sections=[
 ['已展示页面裁决','Issue最小详情与API Key保存：保留待确认范围，新增“终结原保存”的候选恢复流程。',[['Issue详情','issue-overview'],['Key保存','key-save']],'两处UI待采用'],
 ['逐模型测试','明确模型与固定版本，先提示可能费用；未知只查询本次结果。',[['看测试页面','model-test']],'新增原型待审'],
 ['登录与仓库发现 API','登录／回调／重连原结果／退出；发现partial与分页、当前权限分开。',[['登录恢复','auth-recovery']],'完整字段草案'],
 ['模型设置 API','供应商与Key完整保存、单模型测试、仅更换项目模型。保存结果未知可查询或明确终结原操作，不重新发送Key。',[['模型设置','models'],['用于项目','model-apply']],'完整字段草案'],
 ['必要配置来源','部署方登记执行与政策，用户配置模型；缺项保持受限。',[['看配置就绪页','source-settings']],'来源策略待审'],
 ['现有页面异常恢复','加载／空／错误／受限、冲突、未知、原结果清理及晚到响应。',[['看状态演示','recovery-states'],['项目设置','settings']],'恢复矩阵与原型']
];
const btn=(label,route)=>`<button data-go="${route}">${label} →</button>`;
function review(){return `<main class="page"><div class="eyebrow">RepoMesh · 首批设计总包</div><h1>六项，一次看完</h1><p class="intro">页面、接口草案、配置来源和异常恢复集中在这里。已有采用范围保留；新方案统一待审，开发另行进行。</p><p class="footer">配套完整评审文档已随本次对话交付，各项有独立决定编号。</p><div class="rows">${sections.map((x,i)=>`<section class="row"><span class="num">0${i+1}</span><div><h2>${x[0]}</h2><p>${x[1]}</p><div class="actions">${x[2].map(a=>btn(...a)).join('')}</div><small>${i===2?'登录恢复三项UI已采用，机器协议另审。':i===3?'保存、测试、应用各自恢复，不把项目PATCH当模型专用接口。':i===4?'展示的是候选配置状态，不是部署或运行结果。':'原型仅内存演示，不是接口验收。'}</small></div><span class="tag">${x[3]}</span></section>`).join('')}</div><p class="footer">本包完整覆盖本次六组收尾的待审内容；技术核对、用户采用、产品实现和真实验收分别记录。</p></main>`;}
const cases={normal:'正常记录',loading:'首次加载',empty:'没有记录',error:'读取失败',unknownAccess:'权限待核',forbidden:'当前无法访问',cursor:'分页已过期',conflict:'资料修订冲突',unknown:'保存结果未知',notFound:'原结果暂未查到',removed:'原结果已清理',inputLost:'原输入已丢失',late:'旧页面响应晚到'};
const pageCases={list:['normal','loading','empty','error','unknownAccess','forbidden','cursor','late'],create:['normal','loading','error','unknownAccess','forbidden','unknown','notFound','removed','inputLost','late'],settings:['normal','loading','error','unknownAccess','forbidden','conflict','unknown','notFound','removed','inputLost','late'],detail:['normal','loading','error','unknownAccess','forbidden','late']};
function stateBody(){if(sample==='loading')return '<div role="status">正在读取…</div><div class="skeleton"></div><div class="skeleton"></div>';if(sample==='empty')return '<h2>这里还没有记录</h2><p>在当前有权范围内创建第一条工作记录。</p>'+btn('创建 Issue','create-issue');if(sample==='normal')return page==='detail'?'<h2>#3 订单归档</h2><span class="tag">记录已保存</span><p>运行状态待确认</p>'+btn('查看完整概览','issue-overview'):page==='settings'?'<h2>项目资料</h2><p>订单系统 · 订单服务与运营后台</p>'+btn('进入项目设置','settings'):page==='create'?'<h2>创建 Issue</h2><p>标题、目标、明确仓库范围及关联会话沿已采用弹窗。</p>'+btn('查看创建弹窗','create-issue'):'<div class="item"><span>#1 支付状态筛选</span><span class="tag">记录已建立</span></div><div class="item"><span>#3 订单归档</span><button data-go="issue-overview">查看详情</button></div><p>只读记录与运行观察分开。</p>';
if(sample==='conflict')return '<div class="notice"><h2>项目资料已更新</h2><p>请比较当前内容与自己的修改，再明确确认。</p></div><div class="compare"><div><small>当前值 · 回读示例</small><p>订单系统 · 已补充用途</p></div><div><small>我的修改 · 保留草稿</small><p>订单服务 · 维护归档功能</p></div></div><p>原保存若仍未知，先查询原操作，不进入新写入。</p><button data-state-action="reread">重新读取并核对</button>';
if(sample==='late')return '<div class="notice"><h2>当前仍在新选择的项目</h2><p>旧项目响应已到达，因页面上下文不同而丢弃。</p></div><p>这里不显示旧响应的标题、正文或选择。</p><button data-state-action="late">模拟再收到旧响应</button>';
const texts={error:['暂时无法读取','本次没有取得可靠结果，请重新读取。','重新读取'],unknownAccess:['读取资格待确认','暂不展示旧名称与正文。核查未知不等于已失权。','重新核查'],forbidden:['当前无法访问','请返回有权页面；不通过错误显示受限记录的名称。','返回工作区'],cursor:['列表已变化，需要重新读取','从第一页开始，不混合旧页；手动选择仍需重新核权。','从第一页读取'],unknown:['保存结果待确认','关闭页面不取消已发操作，请查询原结果。','查询原结果'],notFound:['暂未查到原保存结果','原请求仍可能提交，继续保持未知。','继续查询原结果'],removed:['原结果已清理','本操作不能重新执行；可到列表核查当前记录。','返回列表'],inputLost:['原输入已不可恢复','保留原操作定位，只能查询，不能按标题重造请求。','查询原结果']};const x=texts[sample];return `<div class="notice"><h2>${x[0]}</h2><p>${x[1]}</p></div><button data-state-action="${['forbidden','removed'].includes(sample)?'return':'query'}">${x[2]}</button>${['unknown','notFound','inputLost'].includes(sample)?'<button data-state-action="link">复制恢复链接示例</button>':''}`;}
function recovery(){return `<main class="page"><div class="top"><span class="eyebrow">首批页面 · 恢复交互候选</span>${btn('返回六项总览','review')}</div><h1>${({list:'工作记录列表',create:'创建 Issue',settings:'项目设置',detail:'Issue详情'})[page]}</h1><div class="demo"><strong>原型演示控制</strong><select id="recovery-page" aria-label="演示页面">${Object.entries({list:'工作记录列表',create:'创建 Issue',settings:'项目设置',detail:'Issue详情'}).map(([k,v])=>`<option value="${k}" ${page===k?'selected':''}>${v}</option>`).join('')}</select><select id="recovery-case" aria-label="演示状态">${Object.entries(cases).filter(([k])=>pageCases[page].includes(k)).map(([k,v])=>`<option value="${k}" ${sample===k?'selected':''}>${v}</option>`).join('')}</select></div><div class="panel"><div class="panelhead"><span>当前页面状态</span><span class="muted">仅内存样例</span></div><div class="body">${stateBody()}<p role="status" style="margin-top:20px">${message}</p></div></div><p class="footer">本演示说明页面动作与结果，不执行请求、剪贴板写入、权限检查或持久恢复。</p></main>`;}
function sources(){return `<main class="page"><div class="top"><span class="eyebrow">项目配置 · 首批只读就绪摘要</span>${btn('返回六项总览','review')}</div><h1>创建工作前的必要配置</h1><p>候选页面示例：项目可以先保存，创建 Issue 需满足本次必要条件。</p><div class="notice">当前仍缺必要配置，暂不能创建 Issue。这里的状态全部是预置示例。</div><ul class="checks"><li>模型与密钥 <span class="tag">待配置</span><small>由当前用户在模型设置保存；固定版本，不回显Key。</small>${btn('前往模型设置','models')}</li><li>执行环境配置 <span class="tag">已登记 · 示例 v2</span><small>部署方维护不可变版本；登记不代表执行器已经运行。</small></li><li>预算与时限 <span class="tag">待核实</span><small>推荐有限请求次数预算；缺少额度来源，不以0或无限补齐，也不代表金额上限。</small></li><li>GitHub App工作能力 <span class="tag">授权待补齐</span><small>用户读权与App逐动作权限分开；联系部署管理员补齐。</small></li><li>凭据保护基础 <span class="tag">由部署方管理</span><small>独立秘密材料；管理页面不展示根密钥或运行凭据。</small></li></ul><div class="actions">${btn('项目设置','settings')}<button disabled>创建 Issue</button></div><p class="footer">真实来源、导入、配额／计费、权限动作矩阵见六项总包文档。当前没有执行器、模型或GitHub真实接入。</p></main>`;}
function render(){root.innerHTML=screen==='review'?review():screen==='source-settings'?sources():recovery();}
document.addEventListener('click',e=>{const go=e.target.closest('[data-go]');if(go){parent.rmPreview.go(go.dataset.go);return;}const a=e.target.closest('[data-state-action]')?.dataset.stateAction;if(!a)return;if(a==='return'){parent.rmPreview.go(sample==='removed'?'issues':'resume');return;}message=a==='link'?`恢复链接样例：/projects/prj_1/${page==='create'?'issue-creations':'updates'}/原操作ID（未复制、不发请求）`:a==='reread'?'已展示回读样例，请保留草稿并重新确认。':a==='late'?'旧响应再次被丢弃，当前页面未改变。':'样例查询尚未取得新依据，当前状态保持。';render();});
document.addEventListener('change',e=>{if(e.target.id==='recovery-page'){page=e.target.value;if(!pageCases[page].includes(sample))sample='normal';}if(e.target.id==='recovery-case')sample=e.target.value;message='';render();});window.joinedAPI={navigate(route){screen=route;message='';render();}};
})();</script></body></html>
