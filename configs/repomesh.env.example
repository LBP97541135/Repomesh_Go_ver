# Documentation only: binaries do not automatically load .env files.
# Relative paths are resolved from the current working directory.
REPOMESH_WEB_ADDR=127.0.0.1:8080
REPOMESH_WEB_ASSETS=web/dist

# Used by explicit db commands and configured authentication processes.
# Set a real development connection string in the process environment.
# REPOMESH_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE?sslmode=disable

# Optional deployment JSON; secret values live in separate protected files.
# REPOMESH_AUTH_CONFIG=/etc/repomesh/auth.json

# Optional Jev tool broker: set on host-executor after deploying migration 0058.
# Origin only; HTTPS in deployment, loopback HTTP is allowed for local development.
# Jev provider keys are configured per project in Settings, not in this environment.
# REPOMESH_TYPESAFE_BROKER_URL=https://repomesh.example
